rules_version = '2';

// כללי האבטחה של Team Hub. הם נאכפים בשרת של גוגל, גם אם מישהו עוקף את האפליקציה.
// חשוב: אחרי שינוי בקובץ הזה צריך לפרוס מחדש (firebase deploy --only firestore:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- בעל המערכת: תמיד מנהל-על. לשנות גם ב-public/js/config.js ----
    function ownerEmail() { return 'avichaishahar@gmail.com'; }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner()  { return signedIn() && request.auth.token.email == ownerEmail(); }

    function userDoc()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function linked()   { return signedIn() && exists(userDoc()); }
    function myId()     { return get(userDoc()).data.memberId; }
    function myDoc()    { return /databases/$(database)/documents/members/$(myId()); }
    function myRole()   { return get(myDoc()).data.role; }

    function isAdmin()   { return isOwner() || (linked() && myRole() == 'admin'); }
    function isManager() { return isAdmin() || (linked() && myRole() == 'manager'); }

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function roleOk(r)   { return r in ['member', 'manager', 'admin']; }

    // ---- קוד הצטרפות: מי שהקליד את הקוד הנוכחי רשאי לראות את רשימת השמות ולבחור "זה אני" (חבר רגיל בלבד) ----
    function memberOf(id) { return get(/databases/$(database)/documents/members/$(id)).data; }
    function joinOk() {
      return signedIn()
        && exists(/databases/$(database)/documents/joins/$(request.auth.uid))
        && exists(/databases/$(database)/documents/config/join)
        && get(/databases/$(database)/documents/joins/$(request.auth.uid)).data.code == get(/databases/$(database)/documents/config/join).data.code;
    }

    match /config/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && id == 'join'
                   && request.resource.data.keys().hasOnly(['code'])
                   && request.resource.data.code is string
                   && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 40;
    }

    match /joins/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['code'])
                   && exists(/databases/$(database)/documents/config/join)
                   && request.resource.data.code == get(/databases/$(database)/documents/config/join).data.code;
    }

    // ---- קישור משתמש מחובר לחבר צוות: לפי המייל המאומת, או (לחבר רגיל בלבד) אחרי קוד הצטרפות ----
    match /users/{uid} {
      allow read:   if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['memberId'])
                    && request.resource.data.keys().hasOnly(['memberId', 'email'])
                    && request.resource.data.memberId is string
                    && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
                    && (memberOf(request.resource.data.memberId).email == request.auth.token.email
                        || (joinOk() && memberOf(request.resource.data.memberId).role == 'member'));
      // מילוי מייל החשבון בקישור קיים (לא משנה למי הוא מקושר)
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['memberId', 'email'])
                    && request.resource.data.memberId == resource.data.memberId
                    && request.resource.data.email == request.auth.token.email;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ---- חברי צוות ----
    function photoOk(d) { return !('photo' in d) || (d.photo is string && d.photo.size() < 40000); }

    match /members/{id} {
      // מי שלא מקושר עדיין יכול למצוא רק את הרשומה עם המייל שלו
      allow read: if isOwner() || linked() || joinOk()
                  || (signedIn() && resource.data.email == request.auth.token.email);

      allow create: if (isAdmin() || (isManager() && request.resource.data.role == 'member'))
                    && str(request.resource.data.name, 60) && roleOk(request.resource.data.role) && photoOk(request.resource.data);

      allow update: if str(request.resource.data.name, 60) && roleOk(request.resource.data.role) && photoOk(request.resource.data)
                    && (
                      isAdmin()
                      || (isManager() && request.resource.data.role == resource.data.role && resource.data.role != 'admin')
                      // כל אחד יכול לעדכן פרטים אישיים משלו, בלי לגעת בתפקיד ובמייל
                      || (linked() && myId() == id
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthday', 'phone', 'photo']))
                    );

      allow delete: if isManager() && resource.data.role != 'admin';
    }

    // ---- מפגשים ----
    match /meetups/{id} {
      allow read: if linked() || isOwner();
      // כל חבר מקושר מעדכן רק את אישור ההגעה של עצמו
      allow update: if linked()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp'])
                    && request.resource.data.get('rsvp', {}).diff(resource.data.get('rsvp', {})).affectedKeys().hasOnly([myId()])
                    && request.resource.data.rsvp[myId()] in ['yes', 'maybe', 'no'];
      allow create, update: if isManager() && str(request.resource.data.name, 80)
                    && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 14;
      allow delete: if isManager();
    }

    // ---- הוצאות ----
    match /expenses/{id} {
      allow read: if linked() || isOwner();

      // כל חבר צוות מקושר מוסיף הוצאה, ורק על שמו
      allow create: if (linked() && request.resource.data.addedById == myId() || isAdmin())
                    && request.resource.data.amountCents is int
                    && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 100000000
                    && request.resource.data.type in ['מזון', 'אלכוהול', 'אטרקציה', 'לינה', 'אחר']
                    && str(request.resource.data.meetupId, 64) && str(request.resource.data.payerId, 64)
                    && exists(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId));

      allow update: if isManager()
                    && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
                    && request.resource.data.amountCents <= 100000000;
      allow delete: if isManager();
    }

    // ---- סימון העברות כשולמו: הצד המעביר, הצד המקבל או מנהל ----
    match /payments/{id} {
      allow read: if linked() || isOwner();
      allow create, update: if (isManager() || (linked() && (request.resource.data.fromId == myId() || request.resource.data.toId == myId())))
                    && str(request.resource.data.meetupId, 64) && str(request.resource.data.fromId, 64) && str(request.resource.data.toId, 64)
                    && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
                    && id == request.resource.data.meetupId + '__' + request.resource.data.fromId + '__' + request.resource.data.toId;
      allow delete: if isManager() || (linked() && (resource.data.fromId == myId() || resource.data.toId == myId()));
    }

    match /{other=**} { allow read, write: if false; }
  }
}
